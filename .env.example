# Browser-restricted Google Maps JavaScript API key. Restrict it by HTTP referrer.
GOOGLE_MAPS_API_KEY=
# Server-only Gemini API key. Do not prefix with VITE_ or expose it to the browser.
GEMINI_API_KEY=

# Only required when deploying the standalone Django scaffold, not the Vercel app.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=
